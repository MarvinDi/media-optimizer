# Editor configuration for Media Optimizer
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4

[*.{xml,yml,yaml,md,json,properties,editorconfig}]
indent_size = 2
